# Copy to .env; keep it private and never commit it.
# Append KELLMARKS_AUTH_TOKEN using the token-generation command in docs/INSTALLATION.md.
# No working credential is shipped. Compose refuses startup until a token is set.
KELLMARKS_HTTP_PORT=8787
KELLMARKS_TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
KELLMARKS_PUBLIC_ORIGIN=
KELLMARKS_ALLOWED_ORIGINS=
KELLMARKS_ENABLE_HSTS=0
KELLMARKS_EXTERNAL_REQUESTS=1
KELLMARKS_LOG_LEVEL=INFO
# HTTPS overlay only: a DNS hostname, without scheme, path, or port.
KELLMARKS_DOMAIN=
# The default Compose volume stores /data/data.json. Do not set DATA_FILE here.
# Optional limits (defaults shown):
# KELLMARKS_MAX_REQUEST_BYTES=1048576
# KELLMARKS_MAX_DATA_BYTES=16777216
# KELLMARKS_MAX_ENTRIES=10000
# KELLMARKS_MAX_IMPORT_ENTRIES=5000
# KELLMARKS_WRITE_RATE_LIMIT=120
# KELLMARKS_DDG_RATE_LIMIT=30
# KELLMARKS_AUTH_RATE_LIMIT=20
